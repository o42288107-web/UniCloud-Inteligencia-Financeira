# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/edumanager?schema=public"

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Auth (JWT) ──────────────────────────────────────────────
JWT_SECRET="change-me-to-a-random-256-bit-secret"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="change-me-to-another-random-256-bit-secret"
REFRESH_TOKEN_EXPIRES_IN="7d"

# ─── App ─────────────────────────────────────────────────────
NODE_ENV="development"
API_PORT=3001
WEB_PORT=3000
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"

# ─── Anthropic (IA) ──────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ─── Storage (AWS S3 / Cloudflare R2) ────────────────────────
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="edumanager-uploads"
S3_REGION="us-east-1"

# ─── Firebase (Push Notifications) ───────────────────────────
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""

# ─── Email (SendGrid) ────────────────────────────────────────
SENDGRID_API_KEY=""
EMAIL_FROM="noreply@edumanager.com.br"

# ─── WhatsApp Business ───────────────────────────────────────
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_ID=""
