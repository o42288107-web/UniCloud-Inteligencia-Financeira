# -----------------------------------------------------------------------------
# UniCloud - Despesa x Faturamento - Environment Variables Template
# Copy this file to '.env' and fill in your local credentials.
# -----------------------------------------------------------------------------

# PostgreSQL Database Configuration
DB_USER=seu_usuario_postgres
DB_PASSWORD=sua_senha_postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=unico

# ERP Integration & API Sync
API_BASE_URL=http://localhost/dashboard1/api
RESET_SYNC=true

# AI Agent Integration (OpenRouter)
# Get your key at https://openrouter.ai/
OPENROUTER_API_KEY=sua_chave_api_openrouter_aqui
AI_MODEL=minimax/minimax-m2.5:free
